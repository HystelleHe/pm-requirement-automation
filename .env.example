# =========================================
# PM 需求自动化系统 - 环境变量模板
# 复制为 .env 后填入真实值；.env 不入 git
# =========================================

# === LLM 网关：modelverse.cn（OpenAI 兼容协议，多模型聚合）===
# 一个 token 一个 base_url 调多家模型；具体可用模型取决于 token 套餐
LLM_GATEWAY_URL=https://api.modelverse.cn/v1
LLM_GATEWAY_TOKEN=

# === 模型路由（任务 → 模型）===
# 重型推理任务用强模型，摘要用便宜模型，Critic 务必用不同家模型避免审校盲点
LLM_MODEL_KEYWORD_DISCOVERY=moonshotai/Kimi-K2-Thinking
LLM_MODEL_BREAKDOWN=moonshotai/Kimi-K2-Thinking
LLM_MODEL_PRD_WRITER=moonshotai/Kimi-K2-Thinking
LLM_MODEL_WEB_SUMMARY=deepseek-v4-flash
LLM_MODEL_PRD_CRITIC=glm-5-turbo
LLM_MODEL_EVAL_JUDGE=glm-5-turbo
LLM_MODEL_RESEARCH_SYNTHESIS=moonshotai/Kimi-K2-Thinking

# === 搜索服务（modelverse 不提供，必须用原厂 KEY）===
# Tavily 是当前唯一启用的搜索源，承担「关键词→竞品发现」+「公开网页摘要」两阶段
TAVILY_API_KEY=
# Perplexity 可选：若启用则可替代 Tavily+Kimi 组合做更高质量的关键词→竞品发现
PERPLEXITY_API_KEY=

# === Notion ===
NOTION_API_KEY=                  # Internal Integration Token（ntn_ 开头）
NOTION_PARENT_PAGE_ID=           # 4 个数据库挂靠的父页面 ID（建库时用，运行时不读）
NOTION_DB_REQUIREMENTS=          # A. PM 需求表（触发源）
NOTION_DB_SKILL_LIBRARY=         # B. Skill Library（workspace 顶层共享资产，复用）
NOTION_DB_RESEARCH_CACHE=        # C. 调研结果缓存库
NOTION_DB_EVAL=                  # D. Eval 数据集库

# === Service（FastAPI 能力层）===
SERVICE_PORT=8000

# === Postgres（n8n + langfuse 共用一实例，不同 db）===
POSTGRES_USER=workflow
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB_N8N=n8n
POSTGRES_DB_LANGFUSE=langfuse

# === n8n（编排层）===
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# === Langfuse（LLM 观测）===
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_SECRET=changeme_long_random_string_at_least_32_chars
LANGFUSE_SALT=changeme_long_random_string_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000
# 业务侧调 Langfuse SDK 的凭据；首次去 http://localhost:3000 注册并建 project 获取
# 不填则 LLMRouter 自动降级为不带 trace 的原生 openai SDK（不阻塞业务）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# service 容器内访问 langfuse 服务的地址（用 docker 网络名）；CLI 在 host 跑改 http://localhost:3000
LANGFUSE_HOST=http://langfuse:3000

# === Qdrant（向量库）===
QDRANT_PORT=6333

# === 成本控制 ===
# 注意：reasoning 类模型 token 消耗大，预算建议 3 USD 起步
COST_BUDGET_PER_REQUEST_USD=3.0
CRITIC_MAX_ROUNDS=2               # PRD Critic 循环上限

# === 飞书通知（可选）===
# 飞书群「自定义机器人」webhook URL；不填则 stage 事件只打 stdout，不阻塞业务
# 获取：飞书群设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 webhook 地址
FEISHU_WEBHOOK_URL=
