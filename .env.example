# =========================================
# PM 需求自动化系统 - 环境变量模板
# 复制为 .env 后填入真实值；.env 不入 git
# =========================================

# === LLM API Keys ===
ANTHROPIC_API_KEY=          # Claude（Sonnet 拆解/总结 + Opus 写 PRD）
OPENAI_API_KEY=             # GPT-4（PRD Critic）
PERPLEXITY_API_KEY=         # 关键词→竞品发现
DEEPSEEK_API_KEY=           # 网页/爬虫数据摘要
TAVILY_API_KEY=             # 公开网页搜索

# === Notion ===
NOTION_API_KEY=                  # Internal Integration Token（ntn_ 开头）
NOTION_PARENT_PAGE_ID=           # 4 个数据库挂靠的父页面 ID（建库时用，运行时不读）
NOTION_DB_REQUIREMENTS=          # A. PM 需求表（触发源）
NOTION_DB_SKILL_LIBRARY=         # B. Skill Library（workspace 顶层共享资产，复用）
NOTION_DB_RESEARCH_CACHE=        # C. 调研结果缓存库
NOTION_DB_EVAL=                  # D. Eval 数据集库

# === Service（FastAPI 能力层）===
SERVICE_PORT=8000

# === Postgres（n8n + langfuse 共用一实例，不同 db）===
POSTGRES_USER=workflow
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB_N8N=n8n
POSTGRES_DB_LANGFUSE=langfuse

# === n8n（编排层）===
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# === Langfuse（LLM 观测）===
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_SECRET=changeme_long_random_string_at_least_32_chars
LANGFUSE_SALT=changeme_long_random_string_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000

# === Qdrant（向量库）===
QDRANT_PORT=6333

# === 成本控制 ===
COST_BUDGET_PER_REQUEST_USD=1.0   # 单次需求超过此值告警
CRITIC_MAX_ROUNDS=2               # PRD Critic 循环上限
